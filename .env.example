# ============================================================
# v4 LLM 配置（Go + Eino 重写后的格式）
# ============================================================
#
# 用法：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 填入真实 key
#   3. .env 已在 .gitignore 里，**不会被 git 提交**
#
# 加载顺序（后者覆盖前者）：
#   shell 环境变量 > .env 文件 > 代码默认值
#
# 即：CI/容器里用 export，本地开发靠 .env，二者不冲突
# ============================================================

# LLM provider（agnes/qwen/openai/doubao/deepseek/ollama）
LLM_PROVIDER=qwen

# Qwen / TDP 镜像 key（推荐：速度快 + 免费）
QWEN_API_KEY=你的key

# 可选：自定义 base URL（默认走预设）
# LLM_BASE_URL=https://ai.tdp.fan/api/v1
# LLM_MODEL=qwen3.6-35b-a3b

# Agnes 备用（慢但有时更准）
# AGNES_API_KEY=你的key

# OpenAI 兼容（OpenAI / 豆包 / DeepSeek / Xiaomi MiMo）
# Xiaomi MiMo v2.5 Pro 是 agent 项目的备用 LLM（2026-07-21 添加）
# 用法：export LLM_PROVIDER=openai + LLM_BASE_URL + LLM_MODEL
# OPENAI_API_KEY=你的key
# LLM_BASE_URL=https://api-oc.xiaomimimo.com/v1
# LLM_MODEL=xiaomi/mimo-v2.5-pro

# ============================================================
# v3 Python 时代遗留（保留兼容，不再使用）
# ============================================================

# 文心大模型 API 配置（AI Studio token）
ERNIEBOT_ACCESS_TOKEN=你的token

# 强模型 token（可选，为空则与上面共用）
ERNIEBOT_STRONG_TOKEN=



# 模型配置（可选，有默认值）
MODEL_LITE=ernie-lite
MODEL_STRONG=ernie-3.5

# MCP 服务器配置（可选）
# MCP_SERVER_PORT=8765

# Worker 配置
# WORKER_HEARTBEAT_INTERVAL=10

# 安全配置（可选）
# CONFIRM_TIMEOUT=30

# 日志级别
# LOG_LEVEL=INFO
# ============ Advisor Agent (v5 M5+, 团队模式) ============
# Advisor 是 RunComplex 模式下 plan_review / escalation / taste_pass 三个
# commitment boundaries 介入的"贵模型判断"角色（advisor-orchestrator-worker skill）
#
# 留空 ADVISOR_API_KEY → 自动降级到 no-advisor 模式（与 v4 老行为一致）
#
# 默认推荐：mengyu.ltd 中转的 KAT-Coder-Exp-72B-1010（代码推理强 + 思考充分）
# 也可换：openai / deepseek / 自部署（任何 OpenAI 兼容服务）

# ADVISOR_PROVIDER=mengyu
# ADVISOR_BASE_URL=https://ai-api.mengyu.ltd/v1
# ADVISOR_MODEL=KAT-Coder-Exp-72B-1010
# ADVISOR_API_KEY=
